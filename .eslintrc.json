{
  "root": true,
  "env": {
    "browser": true,
    "es2022": true,
    "serviceworker": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "globals": {
    "Chart": "readonly"
  },
  "rules": {
    "no-undef": "error"
  },
  "overrides": [
    {
      "files": [
        "static/app.js",
        "static/js/main.js",
        "static/js/events.js",
        "static/js/state.js",
        "static/js/utils.js",
        "static/js/audit.js",
        "static/js/managed-firms.js",
        "static/js/notifications.js",
        "static/js/board.js",
        "static/js/admin.js",
        "static/js/tasks.js",
        "static/js/dashboard.js",
        "static/js/report.js",
        "static/js/scheduled.js",
        "static/js/kb.js",
        "static/js/settings.js",
        "static/js/pool.js",
        "static/js/projects.js",
        "static/js/backup.js",
        "static/js/archive.js"
      ],
      "parserOptions": {
        "sourceType": "module"
      }
    }
  ]
}
