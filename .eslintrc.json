{
  "root": true,
  "env": {
    "browser": true,
    "es2022": true,
    "serviceworker": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "globals": {
    "Chart": "readonly",
    "escapeHtml": "readonly",
    "_cssVar": "readonly",
    "_chartTheme": "readonly",
    "_centerTextPlugin": "readonly",
    "unreadBadge": "readonly",
    "priorityBadge": "readonly",
    "slaBadge": "readonly",
    "portalBadge": "readonly",
    "_slaRemainingHuman": "readonly",
    "_periodCompletionLabel": "readonly",
    "_periodCompletionBadge": "readonly",
    "TODAY": "readonly",
    "CAT_LABELS": "readonly",
    "dlClass": "readonly",
    "dlText": "readonly",
    "catLabel": "readonly",
    "_routineOverdueLabel": "readonly",
    "_appVersionSuffix": "readonly"
  },
  "rules": {
    "no-undef": "error"
  }
}
